<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.froggerpro.privacy">

    <!-- 寫入 secure/global settings 需要（併同 privapp whitelist ✓） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
        DeviceConfig（廣告框架 AdServices 等）讀寫需要。
        兩者皆為 signature 級（protectionLevel = signature|verifier|configurator /
        signature|preinstalled），本 App 以 platform 憑證簽章 ⇒ 符合 ✓
        （依 frameworks/base/core/res/AndroidManifest.xml:4947、4962 ✓）
    -->
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_lock"
        android:theme="@android:style/Theme.DeviceDefault.Settings"
        android:allowBackup="false">

        <activity
            android:name=".PrivacySettingsActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
