<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/tier_title">

        <ListPreference
            android:key="tier"
            android:title="@string/tier_title"
            android:summary="@string/tier_summary"
            android:entries="@array/tier_entries"
            android:entryValues="@array/tier_values"
            android:persistent="false" />

        <Preference
            android:title="@string/verify_hint"
            android:summary="@string/verify_hint" />

    </PreferenceCategory>

    <!-- B 類：B3 的入口 —— 把使用者送到【系統自己的】隱私儀表板 ✓
         理由：自造 per-app 清單會落後 AOSP 改版 ✗ 平台 UI 才是真相來源 ✓
         title/summary 用字面值 ⇒ 不必動 strings.xml ✓ 減少出錯面 ✓ -->
    <PreferenceCategory android:title="隱私儀表板（B 類）">

        <Preference
            android:key="privacy_dashboard"
            android:title="開啟系統隱私儀表板"
            android:summary="檢視／調整每個 App 的相機、麥克風、定位權限（交由平台 UI 處理 ✓）"
            android:persistent="false" />

        <!-- N 類：LineageOS 統計上報（stats_collection ✓ 機制已實機驗證 ✓）
             樹內預設 true（開啟 ✗）⇒ 提供關閉開關 ✓；用字面標題 ⇒ 不必動 strings.xml ✓ -->
        <SwitchPreference
            android:key="stats_off"
            android:title="關閉 LineageOS 統計上報"
            android:summary="stats_collection=0（關閉）／1（開啟）。樹內預設為開啟 ⇒ 可確實關閉 ✓"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_network">

        <SwitchPreference
            android:key="agps_off"
            android:title="@string/agps_title"
            android:summary="@string/agps_summary"
            android:persistent="false" />

        <SwitchPreference
            android:key="adb_off"
            android:title="@string/adb_title"
            android:summary="@string/adb_summary"
            android:persistent="false" />

        <SwitchPreference
            android:key="captive_portal_off"
            android:title="@string/captive_portal_title"
            android:summary="@string/captive_portal_summary"
            android:persistent="false" />

        <SwitchPreference
            android:key="private_dns_on"
            android:title="@string/private_dns_title"
            android:summary="@string/private_dns_summary"
            android:persistent="false" />

        <EditTextPreference
            android:key="private_dns_host"
            android:title="@string/private_dns_host_title"
            android:dialogTitle="@string/private_dns_host_title"
            android:persistent="false" />

        <EditTextPreference
            android:key="ntp_server"
            android:title="@string/ntp_title"
            android:dialogTitle="@string/ntp_title"
            android:persistent="false" />

        <SwitchPreference
            android:key="auto_time_off"
            android:title="@string/auto_time_title"
            android:summary="@string/auto_time_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_location">

        <SwitchPreference
            android:key="location_device_only"
            android:title="@string/location_title"
            android:summary="@string/location_summary"
            android:persistent="false" />

        <SwitchPreference
            android:key="wifi_scan_off"
            android:title="@string/wifi_scan_title"
            android:summary="@string/wifi_scan_summary"
            android:persistent="false" />

        <SwitchPreference
            android:key="ble_scan_off"
            android:title="@string/ble_scan_title"
            android:summary="@string/ble_scan_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_sensors">

        <SwitchPreference
            android:key="sensor_privacy_on"
            android:title="@string/sensor_privacy_title"
            android:summary="@string/sensor_privacy_summary"
            android:persistent="false" />

        <Preference
            android:title="@string/sensor_privacy_note_title"
            android:summary="@string/sensor_privacy_note_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_radio">

        <!-- 2026-10-08：無 SIM 自動飛航（★實測驅動 ✗★）
             由來 ✓：沒插 SIM 時 dumpsys batterystats 顯示螢幕關閉/doze 段
                     316.5 mAh ✗ 其中 299 mAh 是 mobile_radio ✗（modem 一直掃描註冊 ✗）
             機制 ✓：Settings.Global.putInt(AIRPLANE_MODE_ON, 1) 系統即生效 ✓（已實測 ✓）
             設計 ✓：只在【使用者切換】時動作 ✓ 不主動在開機時改 ✗（避免使用者莫名斷網 ✗）
             標題／摘要用字面值 ⇒ 不必為此動 strings.xml ✓（摘要內容由程式動態覆寫 ✓） -->
        <SwitchPreference
            android:key="nosim_airplane_off"
            android:title="無 SIM 時自動開啟飛航"
            android:summary="沒插 SIM 卡時，讓 modem 停止持續掃描以省電（無線電佔待機耗電約 93% ✗）"
            android:persistent="false" />

        <SwitchPreference
            android:key="nfc_off"
            android:title="@string/nfc_title"
            android:summary="@string/nfc_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_ads">

        <SwitchPreference
            android:key="adservices_off"
            android:title="@string/adservices_title"
            android:summary="@string/adservices_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_logs">

        <Preference
            android:key="logcatd_status"
            android:title="@string/logcatd_title"
            android:summary="@string/logcatd_summary"
            android:persistent="false" />

        <Preference
            android:title="@string/logcatd_note_title"
            android:summary="@string/logcatd_note_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/readonly_cat_title">

        <Preference
            android:title="@string/adb_secure_title"
            android:summary="@string/adb_secure_summary" />

        <Preference
            android:title="@string/vendor_title"
            android:summary="@string/vendor_summary" />

        <Preference
            android:title="@string/kernel_title"
            android:summary="@string/kernel_summary" />

        <Preference
            android:title="@string/updater_title"
            android:summary="@string/updater_summary" />

        <Preference
            android:title="@string/mac_title"
            android:summary="@string/mac_summary" />

        <Preference
            android:title="@string/widevine_title"
            android:summary="@string/widevine_summary" />

    </PreferenceCategory>

</PreferenceScreen>
