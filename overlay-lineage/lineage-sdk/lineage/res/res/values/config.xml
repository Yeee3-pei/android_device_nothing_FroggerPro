<resources>
    <!-- Some devices might require always setting the toggle instead of set based on current toggle
     value. If this is the case, set this config to true to let the toggle provider always set
     charging enabled status regardless of the current status. -->
    <bool name="config_chargingControlToggleSetAlways">true</bool>

    <!-- Whether device has screen with higher aspect ratio -->
    <bool name="config_haveHigherAspectRatioScreen">true</bool>

    <!-- Hardware keys present on the device, stored as a bit field.
         This integer should equal the sum of the corresponding value for each
         of the following keys present:
             1 - Home
             2 - Back
             4 - Menu
             8 - Assistant (search)
            16 - App switch
            32 - Camera
            64 - Volume rocker
         For example, a device with Home, Back and Menu keys would set this
         config to 7. -->
    <integer name="config_deviceHardwareKeys">72</integer>

    <!-- Hardware keys present on the device with the ability to wake, stored as a bit field.
         This integer should equal the sum of the corresponding value for each
         of the following keys present:
             1 - Home
             2 - Back
             4 - Menu
             8 - Assistant (search)
            16 - App switch
            32 - Camera
            64 - Volume rocker
         For example, a device with Home, Back and Menu keys would set this
         config to 7. -->
    <integer name="config_deviceHardwareWakeKeys">72</integer>

    <!-- This device has no hardware button/keyboard backlight.
         LineageOS' lineage-sdk default for both is 1.0 (full brightness), so
         PowerManagerService.updateSettingsLocked() ends up with mButtonBrightness = 1.0
         and, on every screen-on, pushes a BUTTONS light request
         (frameworks/base .../power/PowerManagerService.java: mButtonsLight.setBrightness()).

         The stock QTI lights HAL on this device maps that BUTTONS request onto the
         3-channel RGB LED (/sys/class/leds/{red,green,blue}, PMIC pmxr2230 led-controller).
         Result: the RGB LED lit up full white (red=green=blue=255) every time the screen
         was turned on, and it stayed lit - "the Glyph red LED turns itself on when the
         screen comes on". Confirmed in the HAL log:
             D/vendor.qti.lights: colorRGB = FFFFFFFF, mode = 0, onMs = 0, offMs = 0, rc: 0
         exactly at screen-on, and colorRGB = FF000000 at screen-off, matching
         `dumpsys lights` Light id=2 (LightType.BUTTONS) toggling ffffffff <-> ff000000.

         Keeping both defaults at 0 means the brightness is not valid
         (isValidButtonBrightness() requires value > BRIGHTNESS_MIN), so no buttons light
         request is made and the RGB LED stays off. -->
    <dimen name="config_buttonBrightnessSettingDefaultFloat">0.0</dimen>
    <dimen name="config_keyboardBrightnessSettingDefaultFloat">0.0</dimen>
</resources>
