<resources>
    <!-- Whether to handle slot change events -->
    <bool name="config_handle_sim_slot_change">true</bool>

    <!-- Whether to show peak refresh rate in display settings -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>

    <!-- Whether to show min refresh rate in display settings -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- Display settings screen, Color mode options. Must be the same length and order as
         config_color_mode_options_values below. Only the values that also appear in
         frameworks/base/core/res/res/values/config.xml's config_availableColorModes are shown. -->
    <string-array translatable="false" name="config_color_mode_options_strings">
        <item>Alive</item>
        <item>Boosted</item>
        <item>Standard</item>
    </string-array>

    <!-- Display settings screen, Color mode options. Must be the same length and order as
         config_color_mode_options_strings above. Only the values that also appear in
         frameworks/base/core/res/res/values/config.xml's config_availableColorModes are shown. -->
    <integer-array translatable="false" name="config_color_mode_options_values">
        <item>260</item>
        <item>1</item>
        <item>0</item>
    </integer-array>

    <!-- The radius of the enrollment progress bar, in DP. -->
    <integer name="config_udfpsEnrollProgressBar" translatable="false">94</integer>
    <!-- 前面、螢幕下的指紋感應器（FOD）：
         goodix blob 回報的 sensor props 不是 UDFPS ⇒ SettingWizard 掉到最後的
         front/rear 分支並因為兩個 bool 都是 false 而畫【手機背面】✗
         這裡開 front ⇒ 顯示 front overlay 插圖 + front 文案 ✓ -->
    <bool name="config_is_front_facing_fps">true</bool>
    <!-- FOD 在螢幕下半部 ⇒ 把動畫圖示移到對應位置 ✓ -->
    <item name="fingerprint_sensor_location_fraction_x" type="fraction">50%</item>
    <item name="fingerprint_sensor_location_fraction_y" type="fraction">68%</item>

</resources>
