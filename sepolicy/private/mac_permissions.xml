<?xml version="1.0" encoding="iso-8859-1"?>
<!-- C199：com.android.bt APEX 的 seinfo 修正
     現象：com.android.bluetooth 反覆 abort（zygote64：selinux_android_setcontext 失敗）
     真因：plat/system_ext/vendor 的 mac_permissions 只綁
           build/make/target/product/security/bluetooth.x509.pem（指紋 a6ccc500…）
           而 com.android.bt APEX 實際用
           packages/modules/Bluetooth/apex/key/com.android.bt.x509.pem（指紋 40d36325…）
           ⇒ 兩把不同 ⇒ seinfo 拿不到 bluetooth
           ⇒ seapp_contexts 的 user=bluetooth seinfo=bluetooth 不匹配
           ⇒ selinux_android_setcontext 失敗 ⇒ zygote abort
     ★ 格式教訓：AOSP 產出的簽章是【hex DER】✗
       我第一版寫成 base64 ✗ ⇒ 被忽略（grep 不到 hex 前綴 ✓）
     修法：把 APEX 那把金鑰以 hex DER 形式也映射到 seinfo=bluetooth -->
<policy>
    <signer signature="">
        <seinfo value="bluetooth"/>
    </signer>
</policy>
