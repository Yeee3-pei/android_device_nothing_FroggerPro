# ---- 3) 規則 ----
allow init hal_fingerprint_default_exec:file { read getattr map execute open };
allow init hal_fingerprint_default:process { transition };
allow hal_fingerprint_default hal_fingerprint_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_fingerprint_default:process { noatsecure };
allow init hal_fingerprint_default:process { siginh rlimitinh };
type_transition init hal_fingerprint_default_exec:process hal_fingerprint_default;
allow hal_fingerprint_default fwk_sensor_service:service_manager { find };
